{
  "manifest_version": 3,
  "name": "TF2 Jump Demo SyncView",
  "version": "1.3.0",
  "description": "Watch Tempus records or compare two runs with synchronized playback and seeking.",
  "content_scripts": [
    {
      "matches": ["https://demos.tf2jump.xyz/*"],
      "js": ["compare.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tempus2.xyz/*"],
      "js": ["tempus-picker.js"],
      "run_at": "document_idle"
    }
  ]
}
